# ===================== DZPLAY configuration =====================
# Copy to .env and adjust. Every limit / TTL lives here, not in the code.
# Durations are in seconds.

# --- application ---------------------------------------------------
ENV=development                     # production enforces SECRET_KEY + secure cookies
SECRET_KEY=                         # required in production: python -m app.admin_cli gen-secret
DATABASE_URL=sqlite:///./dzplay.db  # production: postgresql+psycopg://user:pass@host:5432/dzplay
REDIS_URL=                          # optional: redis://localhost:6379/0 (needed for >1 worker/instance)
LOG_LEVEL=INFO

# --- HTTP / proxies -------------------------------------------------
# COOKIE_SECURE=true                # defaults to true when ENV=production (requires HTTPS)
SESSION_DURATION=2592000            # 30 days, sliding
TRUST_PROXY_HEADERS=false           # true when running behind Caddy/Nginx/Railway
TRUSTED_PROXY_COUNT=1
ALLOWED_ORIGINS=                    # extra origins for WebSocket/API (comma separated)

# --- login & registration protection --------------------------------
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=3                # consecutive failures before a block
IP_BLOCK_DURATION=14400             # 4 hours
LOGIN_BLOCK_SCOPE=ip_account        # ip_account (protects users behind shared IPs) | ip (whole IP)
IP_MAX_FAILED_LOGINS=10             # whole-IP block after this many failures across accounts
LOGIN_FAILURE_WINDOW=14400
ACCOUNT_MAX_FAILED_LOGINS=10        # per account from any IP
ACCOUNT_LOCK_DURATION=900
LOGIN_BACKOFF_BASE=1                # progressive delay 1s, 2s, 4s ...
LOGIN_BACKOFF_MAX=30
MAX_ACCOUNTS_PER_IP=2
ACCOUNTS_PER_IP_WINDOW=14400        # 4 hours
TRUSTED_IPS=                        # IPs exempt from IP limits (comma separated)

# --- anti-bot (proof-of-work, no third party) -----------------------
ANTIBOT_ENABLED=true
POW_MAX_NUMBER=60000                # normal difficulty
POW_ELEVATED_MAX_NUMBER=400000      # for IPs with recent failures
POW_CHALLENGE_TTL=300

# --- Google Sign-In (optional) --------------------------------------
GOOGLE_CLIENT_ID=                   # xxxx.apps.googleusercontent.com — empty hides the button

# --- messages & anti-spam --------------------------------------------
MAX_MESSAGE_LENGTH=1000
LINK_POLICY=reject                  # reject | allow_plain (never clickable)
MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGES_PER_HOUR=120
MAX_CONSECUTIVE_MESSAGES=8          # before the other side replies
DUPLICATE_MESSAGE_WINDOW=600        # the same idea posted again within this window is refused
MAX_REPORTS_PER_HOUR=10
REPORT_AUTO_SUSPEND_THRESHOLD=5     # distinct reporters in 24h -> suspended for review (0 = off)

# --- public ideas (posts) -------------------------------------------------
MAX_POST_LENGTH=2000
MAX_COMMENT_LENGTH=500
MAX_POSTS_PER_HOUR=5
MAX_POSTS_PER_DAY=20
MAX_COMMENTS_PER_MINUTE=6
MAX_COMMENTS_PER_HOUR=60
MAX_REACTIONS_PER_MINUTE=60
# feed ranking (weighted random draw: randomness first, freshness/engagement only bias it)
FEED_PAGE_SIZE=15
FEED_CANDIDATE_POOL=500             # most recent posts considered per feed session
FEED_FRESHNESS_HALF_LIFE_HOURS=24
FEED_FRESHNESS_FLOOR=0.15           # older posts keep at least this weight
FEED_ENGAGEMENT_WEIGHT=0.35         # likes help on a log scale...
FEED_ENGAGEMENT_CAP=2.5             # ...up to this max boost
FEED_SEEN_PENALTY=0.5               # posts you already reacted to
FEED_OWN_POST_PENALTY=0.5

# --- temporary storage (TTL) --------------------------------------------
MESSAGE_TTL=604800                  # 7 days max on the server
MESSAGE_TTL_AFTER_READ=86400        # 1 day once read
CONVERSATION_IDLE_TTL=1209600       # 14 days without activity
LEGACY_ANON_RETENTION_DAYS=7        # V6: old anonymous chats stay read-only this long, then deploy/v6-cleanup.sh anon
CLEANUP_INTERVAL=300
SECURITY_EVENT_RETENTION=2592000    # 30 days
REPORT_RETENTION=7776000            # 90 days (open reports are kept)

# --- Web Push (optional): python -m app.admin_cli gen-vapid ----------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,push.services.mozilla.com,notify.windows.com,push.apple.com,updates.push.services.mozilla.com  # SSRF guard: push services the server may call

# --- Android app (Digital Asset Links for the full-screen app) -------------------
ANDROID_APP_PACKAGE=io.dzplay.app
ANDROID_CERT_SHA256=46:15:BE:65:23:30:C9:0A:C6:2C:C3:2C:E5:6B:0C:C0:CB:03:2B:8B:37:E7:13:86:0C:66:D0:A0:FA:EC:79:BF


# User protection: scan new messages/comments for threats, blackmail, harassment, insults and
# contact sharing; hits are queued for review in /admin (users are told in the privacy policy).
MODERATION_ENABLED=true
# Extra words/phrases, comma separated ("word*" = starts with)
MODERATION_EXTRA_WORDS=


# =============================================================================
# V3: admin panel, Telegram bot, media, password recovery, e-mail,
# engagement control. Secrets stay EMPTY here — put them in .env only.
# =============================================================================
# --- admin panel (separate admin accounts + TOTP 2FA) ----------------------
PUBLIC_URL=  # https://your-domain (written by the installer; used to register the Telegram webhook)
ADMIN_PATH=  # secret URL prefix of the panel, e.g. /panel-x7f3k9q2; empty disables the panel
ADMIN_IP_ALLOWLIST=  # optional comma-separated IPs/CIDRs allowed to reach the panel
ADMIN_SESSION_TTL=43200  # absolute lifetime of an admin session
ADMIN_SESSION_IDLE=1800  # admin session ends after this much inactivity
ADMIN_LOGIN_MAX_FAILURES=5  # wrong logins per network (and per username) ...
ADMIN_LOGIN_WINDOW=900  # ... within this window lock the panel login for that window
AUDIT_LOG_RETENTION=31536000
ADMIN_API_PER_MINUTE=240  # requests per admin session per minute (the panel needs ~10 per screen)
ADMIN_API_ANON_PER_MINUTE=30  # unauthenticated panel API requests per network per minute

# --- Telegram bot (stats, password-recovery requests, moderation buttons) ---
TELEGRAM_BOT_TOKEN=  # secret: .env only
TELEGRAM_ADMIN_CHAT_ID=  # only this chat may control the bot
TELEGRAM_WEBHOOK_SECRET=  # secret: sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_API_BASE=https://api.telegram.org  # or a Local Bot API server
TELEGRAM_MAX_FILE_MB=20  # getFile limit of the public Bot API

# --- media cache + processing ----------------------------------------------
MEDIA_CACHE_DIR=./media-cache
MEDIA_CACHE_MAX_GB=5.0
MEDIA_CACHE_TTL=1209600  # files unused for this long are deleted (refetched on demand)
MEDIA_URL_TTL=7200  # lifetime of signed media URLs
IMAGE_MAX_SIDE=1440
IMAGE_QUALITY=82
IMAGE_MAX_PIXELS=40000000  # decompression-bomb guard

# --- V5: user pictures (Telegram = file store; the server only relays) -------
# Two PRIVATE Telegram chats with the bot as admin (see docs/ADMIN_GUIDE.md §14). IDs can also be set in the panel.
TELEGRAM_STORAGE_CHANNEL_ID=  # private channel holding the files (e.g. -1001234567890)
TELEGRAM_MODERATION_CHAT_ID=  # private group of moderators (buttons); empty = the admin's private chat
UPLOAD_TMP_DIR=./upload-tmp  # tmpfs in docker-compose; files stay there seconds only
UPLOAD_TMP_MAX_MB=512
MEDIA_WORKER=inline  # inline | queue (docker-compose: separate media-worker container, set automatically)
# All limits below can also be changed live from the panel ("الإعدادات"):
UPLOADS_PER_HOUR=20
UPLOAD_IMAGE_TYPES=jpeg,png,webp,heic
UPLOAD_IMAGE_MAX_MB=12
DEVICE_NSFW_CHECK=true
SERVER_NSFW_CHECK=true
NSFW_BLOCK_THRESHOLD=0.70
NSFW_SEXY_THRESHOLD=0.92
CAPTION_BLOCK_CATEGORIES=sexual,threat,blackmail
IDEA_IMAGES_ENABLED=true
IDEA_IMAGE_LIMIT_PER_24H=1
IDEA_IMAGE_REQUIRE_APPROVAL=false
CHAT_IMAGES_ENABLED=true
CHAT_IMAGE_TTL_AFTER_VIEW=60
CHAT_IMAGE_UNOPENED_TTL=86400
CHAT_IMAGE_PER_HOUR=10
CHAT_IMAGE_REPORT_GRACE=600
CHAT_IMAGE_ARCHIVE=false
CHAT_IMAGE_FLAG_SECURE=true
REPORT_AUTO_HIDE_THRESHOLD=3
MEDIA_EVIDENCE_RETENTION_DAYS=180

# --- V5: support tickets + blue star ---------------------------------------------
SUPPORT_INBOX_EMAIL=  # tickets are e-mailed here (Reply-To = the user, so a Gmail reply reaches them directly)
SUPPORT_TICKETS_PER_DAY=3
SUPPORT_MESSAGES_PER_HOUR=10
SUPPORT_MAX_LENGTH=3000
VERIFY_MIN_POSTS=5
VERIFY_MIN_LIKES=20
VERIFY_MIN_ACCOUNT_AGE_DAYS=14
PAYMENT_MIN_AMOUNT=0  # the wallet (currency / network / address) is set from the panel, not here

# --- V5: server monitoring (deploy/monitor.sh, cron every 5 min → Telegram alerts; all optional) ---
MONITOR_DISK_PCT=85  # alert when a disk is this full (%)
MONITOR_LOAD_PER_CPU=2.0  # alert when the 5-min load exceeds CPUs × this
MONITOR_MEM_PCT=92
MONITOR_BANS_PER_HOUR=20  # fail2ban bans in one hour that count as an intrusion spike
MONITOR_REMIND_HOURS=6  # reminder while a problem lasts

# --- password recovery (admin-assisted via Telegram, code by e-mail) -------
RESET_CODE_TTL=86400
RESET_MAX_REQUESTS=3  # requests per network within RESET_IP_WINDOW before a block
RESET_IP_WINDOW=14400
RESET_IP_BLOCK_DURATION=14400
RESET_MAX_PER_EMAIL=3  # requests per e-mail within RESET_EMAIL_WINDOW
RESET_EMAIL_WINDOW=86400
RESET_MAX_CODE_ATTEMPTS=5  # wrong codes before the code is cancelled
RESET_VERIFY_PER_IP_PER_HOUR=20
RESET_TOKEN_TTL=900  # after a correct code, time to choose the new password
RESET_CODE_LENGTH=6

# --- e-mail (SMTP) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=  # secret: .env only
SMTP_FROM=  # e.g. "DZPLAY <no-reply@example.com>"
SMTP_SECURITY=starttls  # starttls | ssl | none (none only for local testing)
SMTP_TIMEOUT=20

# --- engagement control (admin panel) --------------------------------------
SYSTEM_ACCOUNTS=25  # internal accounts team comments are posted from (shown as "dzplay")
ENGAGEMENT_TICK_SECONDS=60  # how often gradual boosts/comment batches advance
ENGAGEMENT_MAX_DURATION_HOURS=720
ENGAGEMENT_MAX_AMOUNT=1000000  # per target and metric
ENGAGEMENT_MAX_TARGETS=200  # per bulk operation
ENGAGEMENT_MAX_COMMENTS=200  # per target per operation

# --- V4: names, people search, direct messages -----------------------------------
DEFAULT_DISPLAY_NAME=dzplay
NAME_MIN_LENGTH=3
NAME_MAX_LENGTH=20
NAME_CHANGE_COOLDOWN_DAYS=14  # going back to "dzplay" is always allowed
NAME_BLOCKED_WORDS=  # extra words not allowed in names, comma separated
SEARCH_PER_MINUTE=20  # people searches per user (anti-scraping)
SEARCH_PER_DAY=300
SEARCH_MAX_RESULTS=20
SEARCH_MAX_PAGES=3
DIRECT_MSG_BEFORE_REPLY_LIMIT=3  # messages before the recipient accepts or replies
DIRECT_NEW_PER_DAY=20
TYPING_EVENTS_PER_MINUTE=30
WS_MAX_MESSAGE_BYTES=16384
WS_MSGS_PER_10S=60

# --- V4: Android notifications + realtime (V6: voice/video calls were removed) --------
FCM_SERVICE_ACCOUNT_FILE=  # optional, secret FILE (not in git): Firebase service account JSON, message notifications on the closed Android app
FCM_PROJECT_ID=
WS_PING_SECONDS=25

# --- V6 phase 2: market (Bybit public spot tickers; no account, no key) -------------
# Panel → الإعدادات → السوق changes these live. Check reachability from the server:
#   docker compose exec app python -m app.admin_cli market-check
MARKET_ENABLED=true
MARKET_BASE_URL=https://api.bybit.com  # or https://api.bytick.com (same API)
MARKET_REFRESH_SECONDS=60
MARKET_KLINE_REFRESH_SECONDS=600  # 24 h sparklines of the 12 coins shown
MARKET_TOP_N=6
MARKET_MIN_TURNOVER_24H=1000000  # USDT
MARKET_EXCLUDE=  # symbols to hide, comma separated (e.g. LUNAUSDT)

# --- V6 phases 3–5c (all editable live in the panel → الإعدادات) --------------------
AVATAR_CHANGES_PER_DAY=3
# membership: features only (star, picture posts, chat pictures) — never any return
MEMBERSHIP_PRICE=50
MEMBERSHIP_REFUNDABLE=true
MEMBERSHIP_REFUND_WINDOW_DAYS=7
MEMBERSHIP_REFUND_FEE=1
MEMBERSHIP_REQUESTS_PER_DAY=3
# promotional rewards («أرباحي»), separate from membership
REFERRAL_ENABLED=true
REFERRAL_REWARD=5
REFERRAL_HOLD_DAYS=14  # must stay longer than MEMBERSHIP_REFUND_WINDOW_DAYS while refunds are on
REFERRAL_FLAG_PER_DAY=3
WITHDRAW_ENABLED=true
WITHDRAW_MIN=10
WITHDRAW_FEE=1
WITHDRAW_REQUESTS_PER_DAY=2
WITHDRAW_NETWORKS=TRC20,BEP20
EMAIL_CODE_TTL=1800  # e-mail codes (refund, withdrawal, giveaway); needs SMTP (panel → الأمان والنظام → البريد)

# --- profile ---------------------------------------------------------------
FOOTER_TEXT=  # optional line at the bottom of «حسابي» (empty = none)

# --- misc ---------------------------------------------------------------------
APP_NAME=DZPLAY
SESSION_COOKIE_NAME=dz_session
PASSWORD_MAX_LENGTH=128

# --- backups (read by deploy/backup.sh and deploy/restore.sh, not by the app) --------
BACKUP_PASSPHRASE=  # secret: generated by the installer; keep a copy OFF the server
BACKUP_DIR=/var/backups/dzplay
BACKUP_KEEP=14  # number of daily backups kept
BACKUP_INCLUDE_ENV=true  # include .env (SECRET_KEY etc.) so a restore keeps 2FA, sessions and hashes valid
BACKUP_RCLONE_REMOTE=  # optional off-server copy, e.g. "b2:my-bucket/dzplay" (needs rclone configured)
